# OpenAI / OpenRouter
OPENROUTER_API_KEY=sk-or-your-key-here

# Execution mode (exact, case-sensitive: BACKTEST | PAPER | SIMULATED | LIVE)
# Unset defaults to PAPER. An empty value, an unknown value, or a non-Unicode
# value makes vault construction fail closed (no manifest, no receipt).
# LIVE requires a non-empty secret-mounted seed or ROBOTRADER_VAULT_MASTER_SEED.
# Every mode still exports a SIMULATED manifest; LIVE is not a custody claim.
ROBOTRADER_EXECUTION_MODE=PAPER

# Simulated vault seed (precedence: /run/secrets/robotrader_master_seed, then this
# environment variable, then the deterministic devnet seed outside LIVE).
# Do not commit a real seed value here.
# ROBOTRADER_VAULT_MASTER_SEED=

# Solana read-only telemetry: a configured public address only. Never a private key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PUBLIC_KEY=

# Binance
BINANCE_API_KEY=your_api_key
BINANCE_SECRET_KEY=your_secret_key

# General
LOG_LEVEL=INFO
