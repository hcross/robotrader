# Robotrader SDLC runtime configuration.
# Override any key with an environment variable of the same name.
# These are defaults; the protocol documents their meaning.

SDLC_CLI=auto
SDLC_MAX_ROUNDS=3
SDLC_MAX_PARALLEL=3
SDLC_BASE_BRANCH=master
SDLC_HUMAN_GATES=merge
SDLC_CLAUDE_PERMISSION_MODE=auto
# Antigravity CLI: model id from `agy models`; leave SDLC_AGY_MODE empty to omit
# --mode (the account may not expose "auto"). Headless cold agents need an
# explicit permission bypass or pre-approved allow-rules.
SDLC_AGY_MODEL=gemini-3.8-flash-medium
SDLC_AGY_MODE=
SDLC_AGY_DANGEROUSLY_SKIP_PERMISSIONS=false
# In headless mode, project custom agents may be read-only. For write roles
# (sdlc-dev), run the default Antigravity agent with the role profile injected.
SDLC_AGY_USE_DEFAULT_AGENT=false
SDLC_AUTO_MERGE=false
