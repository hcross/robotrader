{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotrader.local/sdlc/review-verdict.schema.json",
  "title": "SDLC review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change_id",
    "stage",
    "round",
    "reviewer",
    "reviewed_sha",
    "verdict",
    "summary",
    "findings",
    "closed"
  ],
  "properties": {
    "schema": { "const": "sdlc.verdict/v1" },
    "change_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "stage": { "enum": ["spec", "plan", "dev"] },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "reviewer": {
      "enum": ["sdlc-spec-reviewer", "sdlc-plan-reviewer", "sdlc-dev-reviewer"]
    },
    "reviewed_sha": { "type": "string", "minLength": 7 },
    "verdict": { "enum": ["APPROVE", "CHANGES_REQUESTED", "ESCALATE"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "origin",
          "status",
          "location",
          "evidence",
          "required_fix"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(SPEC|PLAN|DEV)-R[1-3]-F[0-9]{2,3}$" },
          "severity": { "enum": ["blocker", "major", "minor", "nit"] },
          "origin": { "enum": ["initial", "regression", "security", "critical"] },
          "status": { "enum": ["open", "closed", "regressed"] },
          "location": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "required_fix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "closed": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(SPEC|PLAN|DEV)-R[1-3]-F[0-9]{2,3}$" }
    }
  }
}
