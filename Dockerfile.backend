FROM rust:slim-bookworm AS engine-builder

WORKDIR /build/engine-rs
# `contracts/` must be at /build/contracts: `robotrader-common` includes it at
# compile time via `include_str!("../../../../contracts/policy_contract.conf")`.
COPY contracts /build/contracts
COPY engine-rs/Cargo.toml ./Cargo.toml
COPY engine-rs/Cargo.lock ./Cargo.lock
COPY engine-rs/crates ./crates
RUN cargo build --release --locked --bin robotrader-node

FROM python:3.11-slim

WORKDIR /app

# Install Poetry
RUN pip install --no-cache-dir poetry

# Copy Python configuration
COPY backend/pyproject.toml backend/poetry.lock ./

# Install dependencies
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root

# Copy compiled Rust hot-path / replay binary
COPY --from=engine-builder /build/engine-rs/target/release/robotrader-node /app/engine-rs/target/debug/robotrader-node

# Copy the shared policy contract for the Python import path (backend/core/schemas.py).
# The compose bind mount `./backend:/app/backend` does not shadow /app/contracts.
COPY contracts ./contracts

# Copy Python Warm-Path & Control Plane code
COPY backend ./backend

CMD ["uvicorn", "backend.server:app", "--host", "0.0.0.0", "--port", "8000"]
